# =====================================================================
# Syspro Scheduler — Backend environment template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Default credentials are no longer accepted: if any required value is
# missing the server will refuse to start.
# =====================================================================

# development = no rate limits + stack traces in API errors. START_SCHEDULER.cmd forces production.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# SYSPRO Database
# SYSPRO_DB_NAME is REQUIRED (no default). SYSPRO_DB_SERVER is REQUIRED when AUTH_MODE=sql.
SYSPRO_DB_SERVER=localhost
SYSPRO_DB_INSTANCE=SQLEXPRESS04
SYSPRO_DB_NAME=SYSPRO
SYSPRO_DB_AUTH_MODE=windows
SYSPRO_DB_DOMAIN=MYDOMAIN
SYSPRO_DB_USER=yourWindowsUser
SYSPRO_DB_PASSWORD=yourWindowsPassword
SYSPRO_DB_ENCRYPT=false

# Scheduler Database
# SCHEDULER_DB_NAME is REQUIRED (no default). SCHEDULER_DB_SERVER is REQUIRED when AUTH_MODE=sql.
SCHEDULER_DB_SERVER=localhost
SCHEDULER_DB_INSTANCE=SQLEXPRESS04
SCHEDULER_DB_NAME=SCHEDULER
SCHEDULER_DB_AUTH_MODE=windows
SCHEDULER_DB_DOMAIN=MYDOMAIN
SCHEDULER_DB_USER=yourWindowsUser
SCHEDULER_DB_PASSWORD=yourWindowsPassword
SCHEDULER_DB_ENCRYPT=false

# Scheduling Configuration
HORIZON_DAYS=28
SCHEDULE_INTERVAL=3600000
MAX_OVERTIME_HOURS=3.0
BATCH_MIN_SIZE=1
SETUP_TIME_MIN=30
QUEUE_TIME_MIN=15
MOVEMENT_TIME_MIN=10

# Authentication
# JWT secret — leave as-is: the server replaces a missing/placeholder value with a
# random 96-char secret on first start and saves it here.
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Shop-floor wall screens (/shopfloor?key=...). Generated on first start if
# empty; the link is shown in Settings -> Shop-floor screen. Delete it and
# restart to revoke every screen link.
SHOPFLOOR_KEY=

# Only if the UI is hosted on a different origin than this server
# (comma-separated). Leave empty: the UI is served from here.
CORS_ORIGINS=

# Optional: password for the first 'superadmin' on a brand-new scheduler DB
# (min 12 chars). If unset, a random one is printed once to the server console.
# INITIAL_ADMIN_PASSWORD=

# Active Directory / Windows-integrated auth (NTLM)
# Leave blank to disable Windows SSO and use form login only.
AD_DOMAIN=MYDOMAIN
AD_DC_URL=ldap://dc.mydomain.local

# CP-SAT optimisation sidecar (required when engineType='cp-sat')
# Run: cd cp-sat && pip install -r requirements.txt && uvicorn main:app --port 5050
# Or via Docker: docker-compose up cp-sat-sidecar
CP_SAT_URL=http://localhost:5050
