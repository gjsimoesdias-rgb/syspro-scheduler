{
  "name": "syspro-scheduler-frontend",
  "version": "1.0.0",
  "description": "Syspro Scheduler UI - React with Gantt visualization",
  "private": true,
  "dependencies": {
    "@types/papaparse": "^5.5.2",
    "axios": "^1.16.0",
    "date-fns": "^2.30.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.383.0",
    "openapi-fetch": "^0.13.5",
    "papaparse": "^5.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.0",
    "react-router-dom": "^6.11.2",
    "recharts": "^2.7.2",
    "zustand": "^4.3.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^24.0.0",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.0.2",
    "vite": "^8.0.11",
    "vitest": "^4.0.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit",
    "generate-types": "openapi-typescript ../backend/openapi.yaml -o src/api-types.d.ts"
  },
  "size-limit": [
    {
      "path": "build/assets/index-*.js",
      "limit": "400 kB",
      "gzip": true
    },
    {
      "path": "build/assets/index-*.css",
      "limit": "60 kB",
      "gzip": true
    }
  ],
  "proxy": "http://localhost:3000"
}
